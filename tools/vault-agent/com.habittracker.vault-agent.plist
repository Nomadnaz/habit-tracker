<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd unit for the vault agent. Install (user action):
    1. Fill in HABIT_USER_EMAIL / HABIT_USER_PASSWORD below (or wrap in a
       script that sources them from a keychain/env file).
    2. cp com.habittracker.vault-agent.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.habittracker.vault-agent.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.habittracker.vault-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/nova/esp/habit-tracker/tools/vault-agent/index.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HABIT_USER_EMAIL</key>
    <string>FILL_ME_IN</string>
    <key>HABIT_USER_PASSWORD</key>
    <string>FILL_ME_IN</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/vault-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/vault-agent.log</string>
</dict>
</plist>
